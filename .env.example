# =====================================================================
# Kai RegAI — Production Environment Configuration Template
# =====================================================================

# Server Environment ('development', 'staging', 'production')
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Persistence (Use durable filesystem path in production, not :memory:)
# For local dev / testing, you can use: ./data/kai_regai.db
DATABASE_URL=./data/kai_regai.db

# Database Backup Destination Directory
BACKUP_DIR=./backups

# Production Session Secret (Must be >= 32 characters in production)
SESSION_SECRET=replace-with-a-secure-random-32-character-production-secret-key-12345

# Webhook Verification Secret (For payment/entitlement provider webhooks)
WEBHOOK_SECRET=replace-with-a-secure-production-webhook-secret-p13

# CORS Allowed Origins (Comma-separated, no wildcards allowed in production)
CORS_ORIGINS=https://app.kairegai.com,https://api.kairegai.com

# ---------------------------------------------------------------------
# Google Gemini API Configuration (Ask the Astrologer AI Engine)
# ---------------------------------------------------------------------
# Set your Google Gemini API key to enable live AI consultations.
# If omitted or empty, the engine automatically uses deterministic offline mock responses.
GEMINI_API_KEY=

# Default Gemini model (e.g. gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash
