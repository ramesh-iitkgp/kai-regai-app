{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KaiRegAIObservation",
  "description": "Schema for physical palm observations (CV-detected or user-reported) without interpretation.",
  "type": "object",
  "properties": {
    "feature_id": { "type": "string" },
    "observation_type": {
      "type": "string",
      "enum": ["COMPUTER_VISION", "USER_QUESTIONNAIRE", "HYBRID"]
    },
    "timestamp": { "type": "integer" },
    "hand_side": {
      "type": "string",
      "enum": ["LEFT", "RIGHT"]
    },
    "physical_metrics": {
      "type": "object",
      "properties": {
        "presence": { "type": "boolean" },
        "continuity": {
          "type": "string",
          "enum": ["CONTINUOUS", "OVERLAPPING_BREAKS", "CLEAN_BREAKS", "CHAINED", "ABSENT"]
        },
        "curvature_profile": { "type": "string" },
        "origin_anchor": { "type": "string" },
        "termination_anchor": { "type": "string" },
        "length_ratio": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "aspect_ratio": { "type": "number" },
        "detected_branches": { "type": "integer", "minimum": 0 }
      }
    },
    "detection_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  },
  "required": ["feature_id", "observation_type", "physical_metrics", "detection_confidence"]
}
